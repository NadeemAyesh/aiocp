  <meta charset="utf-8">
  <title id="app-title">المنظومة الوطنية المتكاملة لحصر الأضرار - قطاع غزة - مواطنين</title>
  <base href="/">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="title" content="المنظومة الوطنية المتكاملة لحصر الأضرار - قطاع غزة | الهيئة العربية الدولية للإعمار في فلسطين">
  <meta name="description" content="المنظومة الوطنية المتكاملة لحصر الأضرار - قطاع غزة: مبادرة وطنية تُنفَّذ بالتنسيق مع الحكومة الفلسطينية، وتقودها الهيئة العربية الدولية للإعمار في فلسطين. تهدف إلى توثيق حجم ونوع الأضرار التي لحقت بالمباني والقطاعات الحيوية باستخدام منظومة رقمية وجيومكانية حديثة ومعتمدة دوليًا. تمكن المواطنين من تسجيل طلبات الحصر، متابعة حالة الطلبات، الاطلاع على الإحصاءات، تقديم الاعتراضات والشكاوى، وإدارة المعلومات الشخصية.">
  <meta name="keywords" content="المنظومة الوطنية المتكاملة لحصر الأضرار, حصر الأضرار, قطاع غزة, إعادة الإعمار, الهيئة العربية الدولية للإعمار في فلسطين, AIOCP, توثيق الأضرار, قاعدة بيانات الأضرار, المنصة الرقمية, المواطنين, الوحدات السكنية, الحصر الميداني, التقييم المتكامل, الخريطة التفاعلية, ArcGIS, البيانات الجيومكانية, الإغاثة, التعافي المبكر, الحكومة الفلسطينية, فلسطين, غزة">
  <meta name="author" content="الهيئة العربية الدولية للإعمار في فلسطين - Arab International Commission for Reconstruction in Palestine">
  <meta name="copyright" content="© 2026 الهيئة العربية الدولية للإعمار في فلسطين | Arab International Commission for Reconstruction in Palestine">
